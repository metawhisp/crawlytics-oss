{
  "name": "@crawlytics/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@clickhouse/client": "^1.10.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "@crawlytics/detector": "workspace:*",
    "@crawlytics/registry": "workspace:*",
    "@crawlytics/shared": "workspace:*",
    "fastify": "^5.3.2",
    "zod": "^3.24.1"
  }
}
