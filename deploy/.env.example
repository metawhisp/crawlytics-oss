APP_PORT=3000
NODE_ENV=production

# --- TLS / one-command install (compose.tls.yml + install.sh) ---
# Public domain that points (A/AAAA) at this server. Caddy gets a cert for it.
CRAWLYTICS_DOMAIN=analytics.example.com
# Email for Let's Encrypt expiry notices.
CRAWLYTICS_ACME_EMAIL=you@example.com

# --- Data store (ClickHouse) ---
CLICKHOUSE_DATABASE=tracecontrol
CLICKHOUSE_USER=tracecontrol
CLICKHOUSE_PASSWORD=change-me-to-a-long-random-string
CLICKHOUSE_URL=http://clickhouse:8123

# Sites/keys/license persist to this JSON file on a mounted volume.
CRAWLYTICS_METADATA_FILE=/data/metadata.json

# Optional: env-seeded ingest keys ("apiKey:siteId" pairs). Leave empty to
# onboard sites/keys through the dashboard wizard instead.
TC_INGEST_KEYS=
# Long random string; rotating it resets daily visitor hashes.
TC_IP_HASH_SECRET=change-me-to-a-long-random-string

# Generate every secret per install; never ship these example values.
# Dashboard login password. REQUIRED when the instance is internet-facing.
TC_DASHBOARD_PASSWORD=change-me
